# Copy to .env and fill in. Values are referenced from the config file as ${VAR_NAME}.
# NEVER commit .env. Copy it privately (USB, password manager, 1Password). Git does not carry it.

# WooCommerce REST API keys (WP Admin -> WooCommerce -> Settings -> Advanced -> REST API, Read access is enough)
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=

# WordPress Application Password (WP Admin -> Users -> Profile -> Application Passwords)
# Only needed to export drafts/private content; public posts/pages work without it.
WP_APP_USER=
WP_APP_PASSWORD=

# --- Shopify auth: use ONE of the two modes below ---
# Required scopes either way: write_products, write_customers, write_orders,
# write_discounts, write_content, write_files, write_inventory, read_locations,
# read_publications, write_publications

# Mode A (current, 2026+): Dev Dashboard app + client credentials grant.
# dev.shopify.com -> create app -> configure Admin API scopes -> install on your
# store -> app Settings page -> copy Client ID + Secret. The pipeline mints
# 24h offline tokens automatically and refreshes them as needed.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Mode B (legacy custom apps, created before Jan 1 2026 or via the
# "allow legacy custom apps" option where still offered): permanent shpat_ token.
SHOPIFY_ADMIN_TOKEN=

# --- DanDomain (Hostedshop) source ---
# Canonical SOAP names used by sites_add, doctor, seed, and export.
# sites_activate writes these into the generated config (not DD_API_USER / DD_API_PASSWORD / DD_TENANT —
# those names appear only in the annotated skeleton in migration.config.example.json).
DD_SOAP_USERNAME=
DD_SOAP_PASSWORD=

# Probe kit only. DD_PROBE_SHOP is write-consent for --write probes on a scratch shop.
# Do not set it to a real client shop. Not required for doctor or read-only export.
DD_PROBE_SHOP=
DD_STOREFRONT_PRODUCT_URL=

# GraphQL OAuth (doctor/client fallback when the config has no graphql block)
DD_GQL_CLIENT_ID=
DD_GQL_CLIENT_SECRET=
DD_GQL_TENANT=

# FTPS media archive (seeder pictures + probe ftp). Host default is the Hostedshop FTPS endpoint.
DD_FTP_HOST=ftps.mywebshop.io
DD_FTP_USER=
DD_FTP_PASSWORD=
